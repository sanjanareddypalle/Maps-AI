# ==============================================================================
# Google Maps AI — Environment Configuration
# ==============================================================================

# Backend Configuration
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: async SQLite (zero configuration, instant setup)
DATABASE_URL=sqlite+aiosqlite:///./travel_planner.db
# PostgreSQL option:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/travel_planner

# Google AI / Gemini API (powers Google ADK Agent)
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform (Places, Routes, Geocoding)
# Get your Google Maps key from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# Frontend Configuration (place in frontend/.env.local or frontend/.env)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_restricted_google_maps_key_here

# Model Context Protocol (Google Maps MCP)
MCP_ENABLED=true
MCP_SERVER_COMMAND=npx -y @modelcontextprotocol/server-google-maps
